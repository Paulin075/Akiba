<?xml version="1.0" encoding="utf-8"?>
<!-- Splash natif AKIBA (API 21+) : fond blanc, icône centrée. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/akiba_splash" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center">
        <!-- Image dédiée : un <bitmap> ne peut pas pointer vers l'icône
             adaptative (XML) sur Android 8+. -->
        <bitmap
            android:gravity="center"
            android:src="@drawable/akiba_launch_logo" />
    </item>
</layer-list>
